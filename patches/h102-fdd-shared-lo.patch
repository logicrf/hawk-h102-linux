+static int adrv9002_fdd_shared_lo_write(struct adrv9002_rf_phy *phy,
+                                      struct adrv9002_chan *c, u64 freq)
+{
+	struct adi_adrv9001_InitCals init_cals = {0};
+	unsigned long moved = 0, powered = 0, port_mask = 0;
+	int i, ret = 0, cleanup_ret;
+
+	for (i = 0; i < ARRAY_SIZE(phy->channels); i++) {
+		struct adrv9002_chan *chan = phy->channels[i];
+
+		if (!chan->enabled || chan->lo != c->lo)
+			continue;
+		ret = adrv9002_channel_to_state(phy, chan,
+					       ADI_ADRV9001_CHANNEL_CALIBRATED, true);
+		if (ret)
+			goto cleanup;
+		set_bit(i, &moved);
+		port_mask |= ADRV9002_PORT_MASK(chan);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(phy->channels); i++) {
+		struct adrv9002_chan *chan = phy->channels[i];
+
+		if (!test_bit(i, &moved) || chan->power)
+			continue;
+		ret = api_call(phy, adi_adrv9001_Radio_Channel_PowerUp,
+			       chan->port, chan->number);
+		if (ret)
+			goto cleanup;
+		chan->power = true;
+		set_bit(i, &powered);
+	}
+
+	/* Collect both RX and TX calibration masks only after all carriers agree. */
+	for (i = 0; i < ARRAY_SIZE(phy->channels); i++) {
+		if (!test_bit(i, &moved))
+			continue;
+		ret = adrv9002_phy_lo_set(phy, phy->channels[i], &init_cals, freq);
+		if (ret)
+			goto cleanup;
+	}
+	ret = adrv9002_phy_rerun_cals(phy, &init_cals, port_mask);
+	if (ret)
+		goto cleanup;
+
+	/* Keep temporary TX power until every RX has returned through Prime. */
+	for (i = 0; i < ARRAY_SIZE(phy->channels); i++) {
+		struct adrv9002_chan *chan = phy->channels[i];
+
+		if (!test_bit(i, &moved) || chan == c)
+			continue;
+		ret = adrv9002_channel_to_state(phy, chan, chan->cached_state, false);
+		if (ret)
+			goto cleanup;
+	}
+	ret = adrv9002_channel_to_state(phy, c, c->cached_state, false);
+
+cleanup:
+	/* A failed partial carrier/calibration update must not resume user RF.
+	 * Preserve the primary error and still undo every temporary power-up.
+	 */
+	if (ret) {
+		for (i = 0; i < ARRAY_SIZE(phy->channels); i++) {
+			if (!test_bit(i, &moved))
+				continue;
+			cleanup_ret = adrv9002_channel_to_state(phy, phy->channels[i],
+						ADI_ADRV9001_CHANNEL_CALIBRATED, false);
+			if (cleanup_ret)
+				dev_err(&phy->spi->dev, "Shared LO state cleanup failed: %d\n",
+					cleanup_ret);
+		}
+	}
+	for (i = ARRAY_SIZE(phy->channels) - 1; i >= 0; i--) {
+		struct adrv9002_chan *chan = phy->channels[i];
+
+		if (!test_bit(i, &powered))
+			continue;
+		cleanup_ret = api_call(phy, adi_adrv9001_Radio_Channel_PowerDown,
+				       chan->port, chan->number);
+		if (!cleanup_ret)
+			chan->power = false;
+		else {
+			dev_err(&phy->spi->dev, "Shared LO power cleanup failed: %d\n",
+				cleanup_ret);
+			if (!ret)
+				ret = cleanup_ret;
+		}
+	}
+
+	return ret;
 }
 
