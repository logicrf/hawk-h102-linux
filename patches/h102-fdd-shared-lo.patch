+/* FDD ports on a common LO cannot retain different RX/TX carriers. Unlike
+ * TDD, every enabled port on that LO is one tuning transaction. Keep ports
+ * that were powered down temporarily in CALIBRATED through RX Prime; turning
+ * TX power off before Prime can fail in the SDK1 firmware. Never use the
+ * normal power setter here: its cached state may still be RF_ENABLED.
+ */
+static bool adrv9002_fdd_shared_lo(struct adrv9002_rf_phy *phy,
+                                  const struct adrv9002_chan *c)
+{
+	bool rx = false, tx = false;
+	int i;
+
+	if (phy->curr_profile->sysConfig.duplexMode != ADI_ADRV9001_FDD_MODE)
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(phy->channels); i++) {
+		const struct adrv9002_chan *chan = phy->channels[i];
+
+		if (!chan->enabled || chan->lo != c->lo)
+			continue;
+		rx |= chan->port == ADI_RX;
+		tx |= chan->port == ADI_TX;
+	}
+
+	return rx && tx;
+}
