--- /dev/null
+++ b/drivers/iio/adc/h102_adc_reg_bounds.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/**
+ * Copyright (C) LogicRF Technologies (Chengdu) Co., Ltd. All Rights Reserved.
+ * @file       h102_adc_reg_bounds.h
+ * @brief      Validate debug register offsets before ADC MMIO and mutex access.
+ * @details    Preserve the bit31 selector and low16 offset ABI; reject aliases,
+ *             unaligned 32-bit accesses and resources shorter than one word.
+ * @author     LogicRF Technologies
+ * @architect  LogicRF
+ * @email      info@logicrf.com
+ * @website    https://www.logicrf.com
+ * @version    0.1.0
+ * @date       2026-10-14
+ * @note       Used by both primary and secondary AXI ADC debugfs callbacks.
+ */
+#ifndef H102_ADC_REG_BOUNDS_H
+#define H102_ADC_REG_BOUNDS_H
+
+#include <linux/ioport.h>
+
+/** Reject invalid offsets without issuing MMIO or acquiring the device mutex. */
+static inline bool h102_adc_reg_offset_valid(unsigned int reg, resource_size_t size)
+{
+	unsigned int offset = reg & 0xffffU;
+
+	return !(reg & ~0x8000ffffU) && !(offset & 3U) && size >= sizeof(u32) &&
+		offset <= size - sizeof(u32);
+}
+
+#endif /* H102_ADC_REG_BOUNDS_H */
